        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "${DS_MOOCHUB_MYSQL}"
          },
          "format": "table",
          "rawSql": "SELECT\n  CASE\n    WHEN exposure_pv = 0 THEN 0\n    ELSE click_pv / exposure_pv\n  END AS value\nFROM (\n  SELECT\n    COALESCE(SUM(CASE WHEN event_type = 'exposure' THEN pv ELSE 0 END), 0) AS exposure_pv,\n    COALESCE(SUM(CASE WHEN event_type = 'click' THEN pv ELSE 0 END), 0) AS click_pv\n  FROM event_stats_hourly\n  WHERE $__timeFilter(bucket_hour)\n) t;",
          "refId": "A"
        }
      ],
      "title": "点击率 CTR",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "mysql",
        "uid": "${DS_MOOCHUB_MYSQL}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.2
              },
              {
                "color": "green",
                "value": 0.4
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "${DS_MOOCHUB_MYSQL}"
          },
          "format": "table",
          "rawSql": "SELECT\n  CASE\n    WHEN play_start_uv = 0 THEN 0\n    ELSE play_complete_uv / play_start_uv\n  END AS value\nFROM (\n  SELECT\n    COALESCE(SUM(CASE WHEN event_type = 'play_start' THEN uv ELSE 0 END), 0) AS play_start_uv,\n    COALESCE(SUM(CASE WHEN event_type = 'play_complete' THEN uv ELSE 0 END), 0) AS play_complete_uv\n  FROM event_stats_hourly\n  WHERE $__timeFilter(bucket_hour)\n) t;",
          "refId": "A"
        }
      ],
      "title": "完播率",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "mysql",
        "uid": "${DS_MOOCHUB_MYSQL}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 3,
            "showPoints": "never"
          },
          "mappings": [],
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 5
      },
      "id": 5,
      "options": {
        "legend": {
