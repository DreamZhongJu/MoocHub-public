          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "${DS_MOOCHUB_MYSQL}"
          },
          "format": "time_series",
          "rawSql": "SELECT\n  bucket_hour AS time,\n  event_type AS metric,\n  SUM(pv) AS value\nFROM event_stats_hourly\nWHERE event_type IN ('exposure', 'click', 'play_start', 'play_complete')\n  AND $__timeFilter(bucket_hour)\nGROUP BY bucket_hour, event_type\nORDER BY bucket_hour;",
          "refId": "A"
        }
      ],
      "title": "事件趋势（PV）",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "mysql",
        "uid": "${DS_MOOCHUB_MYSQL}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisPlacement": "auto",
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 3,
            "showPoints": "never"
          },
          "mappings": [],
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 5
      },
      "id": 6,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "${DS_MOOCHUB_MYSQL}"
          },
          "format": "time_series",
          "rawSql": "SELECT\n  bucket_hour AS time,\n  CASE\n    WHEN SUM(CASE WHEN event_type = 'exposure' THEN pv ELSE 0 END) = 0 THEN 0\n    ELSE SUM(CASE WHEN event_type = 'click' THEN pv ELSE 0 END) /\n         SUM(CASE WHEN event_type = 'exposure' THEN pv ELSE 0 END)\n  END AS ctr,\n  CASE\n    WHEN SUM(CASE WHEN event_type = 'play_start' THEN uv ELSE 0 END) = 0 THEN 0\n    ELSE SUM(CASE WHEN event_type = 'play_complete' THEN uv ELSE 0 END) /\n         SUM(CASE WHEN event_type = 'play_start' THEN uv ELSE 0 END)\n  END AS complete_rate\nFROM event_stats_hourly\nWHERE $__timeFilter(bucket_hour)\nGROUP BY bucket_hour\nORDER BY bucket_hour;",
          "refId": "A"
        }
      ],
      "title": "CTR/完播率趋势",
      "type": "timeseries"
    },
