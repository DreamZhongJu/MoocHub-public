          },
          "format": "table",
          "rawSql": "SELECT\n  content_type,\n  content_id,\n  SUM(pv) AS click_pv,\n  SUM(uv) AS click_uv\nFROM event_stats_hourly\nWHERE event_type = 'click'\n  AND $__timeFilter(bucket_hour)\nGROUP BY content_type, content_id\nORDER BY click_pv DESC\nLIMIT 20;",
          "refId": "A"
        }
      ],
      "title": "点击 Top 内容",
      "type": "table"
    }
